__pycache__/
*.py[cod]
.venv/
venv/
.env
.ipynb_checkpoints/
.pytest_cache/
.DS_Store

# raw sweep outputs are large; keep the tree, not the contents.
# `!results/**/` is required: a pattern that excludes a directory stops git
# descending into it, so a negation for a file inside can never fire. Without
# that line the two negations below are dead and no manifest is ever tracked.
results/**
!results/**/
!results/.gitkeep
!results/**/manifest.json
!results/**/*.md
# pooled analysis outputs are small and are the paper's numbers; track them
!results/analysis/*.json

# model weights / caches
*.pt
*.safetensors
hf_cache/

# Cloned upstream repos read for protocol reproduction. Never committed:
# they have their own licences and histories. Recorded in RESEARCH_LOG instead.
.external/
